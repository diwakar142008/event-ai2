# ---------------------------------------------------------------------------
# Eventora AI — environment template. Copy to .env and replace placeholders.
# NEVER commit a real .env file or real credentials.
# ---------------------------------------------------------------------------

# --- Backend runtime -------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-with-a-long-random-secret
# SQLite locally. For Postgres use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/eventora
# Relative SQLite paths resolve against backend/.
DATABASE_URL=sqlite:///./eventora.db
AUTO_CREATE_TABLES=true

# --- Browser / sessions ----------------------------------------------------
# Comma-separated exact origins. No wildcards. Include https:// in production.
FRONTEND_ORIGINS=http://localhost:3000
SESSION_TTL_DAYS=7
# Leave unset to infer: secure cookies in production, non-secure locally.
# Production rejects COOKIE_SECURE=false.
# COOKIE_SECURE=true
# Local development only: returns reset tokens in the API response because no
# email provider is configured. Set to false in production.
AUTH_DEV_RESET_ECHO=true

# --- Social sign-in (optional) --------------------------------------------
# Register each callback URL exactly as shown in your OAuth provider console.
# For production, set OAUTH_FRONTEND_URL to the canonical HTTPS frontend origin.
OAUTH_FRONTEND_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Request limits and rate limiting -------------------------------------
MAX_REQUEST_BYTES=512000
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=12
RATE_LIMIT_ML=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Machine learning ------------------------------------------------------
# Artifacts are produced by: python backend/scripts/train_models.py
# Relative paths resolve against backend/.
ML_ARTIFACTS_DIR=ml_artifacts

# --- Generative AI (optional) ---------------------------------------------
# none -> deterministic fallback only. openai -> any OpenAI-compatible endpoint.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2600
AI_MAX_INPUT_CHARS=12000

# --- Frontend (server-side) ------------------------------------------------
# Used by Next.js server components and the same-origin API proxy. Not a secret
# but server-only: do not rename this with a NEXT_PUBLIC_ prefix.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Public canonical origin for metadata/OpenGraph (no secrets).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
